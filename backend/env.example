# ============================================================================
# Local dev uses a local DB. Never put production credentials here.
# ============================================================================
APP_ENV=development
DEBUG=true

# Local Firestore Database Configuration (Firestore Emulator)
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_PROJECT_ID=local-dev-project
FIREBASE_DATABASE_ID=local-dev-db
DATABASE_PROVIDER=firebase

# Storage & Runtime Defaults
STORAGE_PROVIDER=local
STORAGE_DIR=./storage
ALLOW_MEMORY_DB_FALLBACK=false
SEED_DEMO_DATA=true

# Model Flags
YOLO26_ENABLED=true
SAM2_ENABLED=false
FASTER_RCNN_ENABLED=false
DINO_ENABLED=false
FLORENCE_ENABLED=false
CLIP_ENABLED=false
SKIP_MODEL_LOAD=false
AGENT_ENABLED=true


# Azure OpenAI Integration
AZURE_OPENAI_ENDPOINT=https://sp-agentic-ai-foundry.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=1Z2fWlMhFccDQDQPoPKGIciDwKFJSUaUgmDdeGDR2tkVKUUNwaNpJQQJ99CJACYeBjFXJ3w3AAAAACOGMfjh
AZURE_OPENAI_DEPLOYMENT=gpt-5.4-mini
AGENT_ENABLED=true
AGENT_BUDGET_USD=5.0
AGENT_REQUEST_CAP=100
AGENT_SEND_IMAGES=true
AGENT_MAX_IMAGES=12
